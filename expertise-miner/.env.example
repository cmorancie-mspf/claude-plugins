# expertise-miner settings. Every line is optional: with none of them set, transcripts go
# to a local SQLite file and requests go out directly.
#
# Copy this file to  <your home folder>/.expertise-miner/.env  and fill in what you need,
# or set the same names in your environment (the environment wins).
# Never commit a filled-in copy. This example holds names only.

# --- Where data lives -------------------------------------------------------------
# The data folder (corpus, job records, this .env). Environment only: it cannot be set
# from the .env file, because it says where that file is.
# EXPERTISE_MINER_HOME=

# The Python the server runs under. Environment only. Default: the first of py -3,
# python3, python that reports version 3.9 or later.
# EXPERTISE_MINER_PYTHON=

# The SQLite file. Default: corpus.db in the data folder.
# EXPERTISE_MINER_DB=

# --- MongoDB instead of SQLite (optional) --------------------------------------------
# Mongo is used only when this line says so. Needs the pymongo package.
# EXPERTISE_MINER_STORE=mongo
#
# Either one connection string...
# MONGO_URI=
# ...or the parts:
# MONGO_HOST=
# MONGO_PORT=
# MONGO_USER=
# MONGO_PASS=
# MONGO_AUTH_SOURCE=
#
# Database and collection. Defaults: expertise_miner and videos.
# MONGO_DB=
# MONGO_COLLECTION=

# --- Proxy (optional) ------------------------------------------------------------------
# One route:            PROXY_URL=scheme://user:password@host:port   (http, https, socks5, socks5h)
# PROXY_URL=
#
# Several routes on consecutive ports of that address (providers that give one exit
# address per port): the number of ports, starting at the port in PROXY_URL.
# PROXY_PORT_COUNT=
#
# Or an explicit list, comma-separated. When set, it is used and PROXY_URL is ignored.
# PROXY_URLS=
