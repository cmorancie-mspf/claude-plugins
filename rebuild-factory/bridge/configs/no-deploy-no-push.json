{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "*git push*": "deny",
      "*gh release create*": "deny",
      "*npm publish*": "deny",
      "*docker push*": "deny",
      "*wrangler deploy*": "deny",
      "*wrangler delete*": "deny",
      "*wrangler secret*": "deny",
      "*wrangler versions upload*": "deny",
      "*wrangler rollback*": "deny",
      "*vercel deploy*": "deny",
      "*vercel --prod*": "deny",
      "*netlify deploy*": "deny",
      "*firebase deploy*": "deny",
      "*terraform apply*": "deny",
      "*terraform destroy*": "deny",
      "*kubectl apply*": "deny",
      "*kubectl delete*": "deny"
    }
  }
}
